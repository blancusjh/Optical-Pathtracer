# BENCHMARK glossy_reflection — a polished but not perfect silver plate (GGX α 0.04) lying on a table,
# reflecting a sunlit checkered wall behind it. The reflection is glossy: sharp but slightly blurred
# by the plate's roughness, which camera paths (path, bdpt, vcm) render exactly; a photon map that
# gathers at the plate itself (sppm's visible point is the first non-specular surface) blurs it by its
# gather radius.
# Physical parameters: sun 40°, 1e5; wall checker 0.8/0.1, 5 cm squares; silver α 0.04.
# Measurement: Eye (radiance, 320×240, fixed exposure). Reference: path 16384.
units = m
world { sky = uniform(rgb(1, 1, 1, luminance = 0.05))  sun { elevation = 40deg  azimuth = 180deg  luminance = 1e5 } }
material table  { type = diffuse  reflectance = 0.4 }
material wall   { type = diffuse  texture = checker(a = 0.8, b = 0.1, scale = 5cm) }
material silver { type = conductor  metal = silver  roughness = 0.04 }
body Table { type = sheet  size = (2, 2)  position = (0, 0, 0)  material = table }
body Wall  { type = sheet  size = (1.2, 0.8)  position = (0, 0.5, 0.4)  axis = (0, -1, 0)  up = (0, 0, 1)  material = wall }
body Plate { type = sheet  size = (0.5, 0.4)  position = (0, 0.05, 0.002)  material = silver }
observer Eye { position = (0, -0.7, 0.35)  look_at = (0, 0.1, 0.02)  up = (0, 0, 1)  fov = 40deg  pupil = 2mm  focus = 0.85
               resolution = (320, 240)  exposure = -2.5 }
render { detector = Eye  spp = 1024  integrator = path }
