# THE STUDY — a sunlit study to walk through, where every optical phenomenon of the engine meets in
# one room. Late-afternoon sun (30° high) comes through a wide window onto the desk: a tumbler of
# water throws its caustic and holds a nephroid on its bottom; a flint prism splits the beam into a
# spectrum on the desk; a loose magnifier focuses the sun on a printed page and magnifies it for an
# eye above; a mirror on the wall shows it all again; a desk lamp (2800 K) can be looked into; and a
# small Keplerian telescope on a pier looks out of the window at a brick tower 60 m away, which an
# eye at its exit pupil sees magnified 16 times. Nothing is special-cased: the images through the
# lens, the telescope and the mirror, the caustics and the spectrum are what light does here.
# Vertex connection and merging (VCM) renders it, so the caustics are also right where they are seen
# through glass or in the mirror, and the telescope's and magnifier's views are ordinary eye views.
units = m

world {
    sky = gradient(zenith = rgb(0.28, 0.48, 1.0, luminance = 0.6),
                   horizon = rgb(0.95, 0.92, 0.85, luminance = 1.2),
                   ground = rgb(0.25, 0.25, 0.22, luminance = 0.15))
    # Behind the window (+y), light toward −y. Half of the light samples go to the desk lamp (a
    # sampling choice: by power alone the sun, whose emission disc covers the whole garden, takes them all).
    sun { elevation = 30deg  azimuth = 15deg  luminance = 1.2e5  nee_share = 0.5 }
}

# ---------------------------------------------------------------- materials
material plaster { type = diffuse  reflectance = rgb(0.80, 0.78, 0.74)  relief = noise(scale = 3mm, depth = 0.15mm) }
material ceiling { type = diffuse  reflectance = 0.85 }
material oak     { type = diffuse  texture = rings(a = rgb(0.58, 0.40, 0.24), b = rgb(0.40, 0.25, 0.13), scale = 6mm, turbulence = 0.4)
                   relief = noise(scale = 4mm, depth = 0.05mm) }
material walnut  { type = diffuse  texture = rings(a = rgb(0.38, 0.24, 0.14), b = rgb(0.24, 0.14, 0.08), scale = 4mm, turbulence = 0.35) }
material page    { type = diffuse  texture = checker(a = rgb(0.88, 0.87, 0.82), b = rgb(0.08, 0.08, 0.09), scale = 1.5mm)
                   relief = noise(scale = 0.8mm, depth = 0.04mm) }
material coating { type = mirror  reflectance = 0.9 }
material frame   { type = diffuse  reflectance = rgb(0.30, 0.20, 0.12) }
material brass   { type = conductor  metal = gold  roughness = 0.15 }
material black   { type = absorber }
material grass   { type = diffuse  texture = noise(a = rgb(0.16, 0.30, 0.08), b = rgb(0.24, 0.38, 0.10), scale = 0.4)
                   relief = noise(scale = 5cm, depth = 1cm) }
material brick   { type = diffuse  texture = checker(a = rgb(0.52, 0.22, 0.14), b = rgb(0.62, 0.58, 0.52), scale = 0.12)
                   relief = noise(scale = 3cm, depth = 3mm) }
material roof    { type = diffuse  reflectance = rgb(0.30, 0.32, 0.36) }
material leaves  { type = diffuse  reflectance = rgb(0.10, 0.24, 0.07) }
material bark    { type = diffuse  reflectance = rgb(0.26, 0.17, 0.10) }

# ---------------------------------------------------------------- the room: 4 × 3.5 × 2.6 m
body Floor   { type = sheet  size = (4.0, 3.5)  position = (0, 0, 0)  material = oak }
body Ceiling { type = sheet  size = (4.0, 3.5)  position = (0, 0, 2.6)  material = ceiling }
body BackWall  { type = sheet  size = (4.0, 2.6)  position = (0, -1.75, 1.3)  axis = (0, 1, 0)  up = (0, 0, 1)  material = plaster }
body LeftWall  { type = sheet  size = (3.5, 2.6)  position = (-2.0, 0, 1.3)  axis = (1, 0, 0)  up = (0, 0, 1)  material = plaster }
body RightWall { type = sheet  size = (3.5, 2.6)  position = (2.0, 0, 1.3)   axis = (-1, 0, 0) up = (0, 0, 1)  material = plaster }
# The window wall (y = 1.75) around a 1.6 × 1.0 m opening, sill at 0.9 m.
body WinLeft  { type = sheet  size = (1.5, 2.6)  position = (-1.25, 1.75, 1.3)  axis = (0, -1, 0)  up = (0, 0, 1)  material = plaster }
body WinRight { type = sheet  size = (0.9, 2.6)  position = (1.55, 1.75, 1.3)   axis = (0, -1, 0)  up = (0, 0, 1)  material = plaster }
body WinBelow { type = sheet  size = (1.6, 0.9)  position = (0.3, 1.75, 0.45)   axis = (0, -1, 0)  up = (0, 0, 1)  material = plaster }
body WinAbove { type = sheet  size = (1.6, 0.7)  position = (0.3, 1.75, 2.25)   axis = (0, -1, 0)  up = (0, 0, 1)  material = plaster }

# ---------------------------------------------------------------- the desk under the window
body Desk { type = box  size = (1.8, 0.7, 0.04)  position = (0.3, 1.2, 0.73)  material = walnut }
body Leg1 { type = cylinder  radius = 0.025  height = 0.709  position = (-0.52, 0.92, 0.0005)  material = walnut }
body Leg2 { type = cylinder  radius = 0.025  height = 0.709  position = ( 1.12, 0.92, 0.0005)  material = walnut }
body Leg3 { type = cylinder  radius = 0.025  height = 0.709  position = (-0.52, 1.48, 0.0005)  material = walnut }
body Leg4 { type = cylinder  radius = 0.025  height = 0.709  position = ( 1.12, 1.48, 0.0005)  material = walnut }

# A tumbler of water in the sun (as glass_in_sunlight.owe's).
body Glass { type = vessel
             outer = [(0, 0), (32mm, 0, 12mm), (41mm, 38mm, 40mm), (39mm, 92mm)]
             inner = [(0, 16mm), (28mm, 16mm, 10mm), (38mm, 40mm, 38mm), (36.5mm, 92mm)]
             rim = round  glass = N-BK7  liquid = water  level = 58mm  position = (0.05, 1.28, 0.7502) }

# An upright 60° flint prism in the beam: its spectrum falls on the desk beside it.
body Prism { type = prism  apex = 60deg  side = 50mm  length = 80mm  medium = N-SF11
             position = (0.55, 1.32, 0.7904)  rotate = (0, 0, -10deg) }

# A printed page, and a loose f = 100 mm magnifier held 50 mm above it (about 2×).
body Page { type = sheet  size = (0.21, 0.297)  position = (-0.3, 1.18, 0.7502)  material = page }
body Magnifier { type = lens  medium = N-BK7  focal = 100mm  form = bi  diameter = 60mm  thickness = 12mm  rim = ground
                 position = (-0.3, 1.16, 0.806)  axis = (0, 0, 1) }

# A desk lamp: a warm bulb on a brass stem.
body LampBase { type = cylinder  radius = 0.06  height = 0.012  position = (-0.78, 1.42, 0.7502)  material = brass }
body LampStem { type = cylinder  radius = 0.008  height = 0.33  position = (-0.78, 1.42, 0.7625)  material = brass }
body Bulb     { type = sphere  radius = 0.02  position = (-0.78, 1.42, 1.115)  material = black  emission = blackbody(2800K, 600) }

# A mirror on the right wall, facing the desk and the window.
# (The frame stands 1 mm off the wall and the glass 1 mm off the frame: matter never overlaps.)
body MirrorFrame { type = box  size = (0.014, 0.86, 1.06)  position = (1.992, 0.3, 1.35)  material = frame }
body Mirror      { type = flat_mirror  size = (0.8, 1.0)  position = (1.984, 0.3, 1.35)  axis = (-1, 0, 0)  up = (0, 0, 1)
                   material = coating }

# A 16× Keplerian telescope on a pier, looking out of the window at the tower.
body Telescope { type = prescription  file = "../lenses/kepler_16x.lens"  afocal = true  tube = true  eyecup = true
                 tube_material = brass  position = (1.0, 1.55, 1.3)  point_at = (8, 60, 8) }
body Pier { type = cylinder  radius = 0.012  height = 0.44  position = (0.98, 1.35, 0.7502)  material = brass }

# ---------------------------------------------------------------- outside
body Garden { type = sheet  size = (130, 130)  position = (0, 40, -0.02)  material = grass }
body Tower  { type = cylinder  radius = 1.5  height = 14  position = (8, 60, -0.02)  material = brick }
body Spire  { type = sphere  radius = 1.6  position = (8, 60, 13.9)  material = roof }
body Trunk1 { type = cylinder  radius = 0.15  height = 3  position = (-6, 14, -0.02)  material = bark }
body Crown1 { type = sphere  radius = 2.2  position = (-6, 14, 4.6)  material = leaves }
body Trunk2 { type = cylinder  radius = 0.12  height = 2.5  position = (-2, 26, -0.02)  material = bark }
body Crown2 { type = sphere  radius = 1.8  position = (-2, 26, 3.9)  material = leaves }

# ---------------------------------------------------------------- views
observer Room      { position = (-1.3, -1.3, 1.6)  look_at = (0.3, 1.2, 0.85)  up = (0, 0, 1)  fov = 62deg  pupil = 3mm  focus = 3.1
                     resolution = (720, 450) }
observer Desk      { position = (0.25, 0.45, 1.05)  look_at = (0.2, 1.25, 0.76)  up = (0, 0, 1)  fov = 50deg  pupil = 3mm  focus = 0.85
                     resolution = (640, 400) }
# The magnifier's virtual image of the page lies ~0.1 m below it: the eye focuses there.
observer Magnifier { position = (-0.3, 1.02, 1.08)  look_at = (-0.3, 1.17, 0.75)  up = (0, 0, 1)  fov = 40deg  pupil = 3mm  focus = 0.38
                     resolution = (480, 480) }
# Through 16× a tower 60 m away reaches the eye at ~4.3 dioptres: the eye focuses at 0.23 m.
observer Eyepiece  { position = exit_pupil("Telescope")  look_at = (8, 60, 8)  up = (0, 0, 1)  fov = 40deg  pupil = 3mm  focus = 0.23
                     resolution = (480, 480) }

# A physical camera: an 85 mm Petzval-type portrait lens with a real stop and sensor, focused on
# the glass of water, the prism beyond it out of focus. VCM needs an ideal eye, so render it with path (or sppm):
#   owe render scenes/the_study.owe --detector Cam --integrator path --set Cam.f_number=8
camera Cam { lens = "../lenses/portrait_85mm.lens"  sensor = (36mm, 24mm)  resolution = (600, 400)
             position = (-0.9, 0.35, 1.0)  look_at = (0.28, 1.3, 0.8)  up = (0, 0, 1)
             focus = 1.34  f_number = 2.8 }

# A quarter of a light subpath per pixel and iteration: the room's walls keep paths long, and fewer
# paths keep merging affordable (MIS weighs the strategies for whatever number there are).
render { detector = Room  spp = 256  integrator = vcm  photons = 0.25 }
