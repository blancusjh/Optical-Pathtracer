# THE STATUE — nested geometric detail becoming visible under increasing magnification.
# The statue is a sphere carrying ever smaller copies of itself (781 exact spheres,
# radii from 30 cm down to 6 mm). It is observed:
#   Direct       — from 2.2 m, as a person would
#   Close        — from 0.5 m on the mirror-symmetric side, without optics
#   Magnifier    — from the same place, through a hand lens held in the world
#   Telescope    — from 60 m, through a real Keplerian telescope (image inverted)
# Visible detail is limited only by geometry, pupils, aberrations and sampling.
units = m

world {
    sky = gradient(zenith = rgb(0.3, 0.5, 1.0, luminance = 0.6), horizon = rgb(0.9, 0.92, 1.0, luminance = 1.2),
                   ground = rgb(0.25, 0.25, 0.25, luminance = 0.2))
    sun { elevation = 42deg  azimuth = 210deg  luminance = 1.5e5 }
}

material marble  { type = diffuse  texture = noise(a = rgb(0.86, 0.84, 0.80), b = rgb(0.70, 0.68, 0.66), scale = 30mm) }
material granite { type = diffuse  texture = noise(a = rgb(0.30, 0.29, 0.30), b = rgb(0.45, 0.43, 0.42), scale = 8mm) }
material paving  { type = diffuse  texture = noise(a = rgb(0.38, 0.35, 0.30), b = rgb(0.44, 0.41, 0.35), scale = 0.055) }

body Plaza  { type = sheet  size = (300, 300) position = (0, 0, -0.008) material = paving }
# BEGIN CRAFTED MODELS
# Generated by tools/build_scene_models.py; edit its recipes to regenerate.
material Crafted_Plaza_stone_0 { type = diffuse texture = noise(a = rgb(0.4759, 0.4342, 0.3590), b = rgb(0.4331, 0.3951, 0.3267), scale = 0.028) }
body Crafted_Plaza_stone_0 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_0.obj" material = Crafted_Plaza_stone_0 position = (0, 0, 0) }
material Crafted_Plaza_stone_1 { type = diffuse texture = noise(a = rgb(0.5073, 0.4628, 0.3827), b = rgb(0.4616, 0.4211, 0.3483), scale = 0.028) }
body Crafted_Plaza_stone_1 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_1.obj" material = Crafted_Plaza_stone_1 position = (0, 0, 0) }
material Crafted_Plaza_stone_2 { type = diffuse texture = noise(a = rgb(0.5386, 0.4914, 0.4063), b = rgb(0.4902, 0.4472, 0.3698), scale = 0.028) }
body Crafted_Plaza_stone_2 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_2.obj" material = Crafted_Plaza_stone_2 position = (0, 0, 0) }
material Crafted_Plaza_stone_3 { type = diffuse texture = noise(a = rgb(0.5700, 0.5200, 0.4300), b = rgb(0.5187, 0.4732, 0.3913), scale = 0.028) }
body Crafted_Plaza_stone_3 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_3.obj" material = Crafted_Plaza_stone_3 position = (0, 0, 0) }
material Crafted_Plaza_stone_4 { type = diffuse texture = noise(a = rgb(0.6013, 0.5486, 0.4536), b = rgb(0.5472, 0.4992, 0.4128), scale = 0.028) }
body Crafted_Plaza_stone_4 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_4.obj" material = Crafted_Plaza_stone_4 position = (0, 0, 0) }
material Crafted_Plaza_stone_5 { type = diffuse texture = noise(a = rgb(0.6327, 0.5772, 0.4773), b = rgb(0.5758, 0.5253, 0.4343), scale = 0.028) }
body Crafted_Plaza_stone_5 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_5.obj" material = Crafted_Plaza_stone_5 position = (0, 0, 0) }
material Crafted_Plaza_stone_6 { type = diffuse texture = noise(a = rgb(0.6640, 0.6058, 0.5010), b = rgb(0.6043, 0.5513, 0.4559), scale = 0.028) }
body Crafted_Plaza_stone_6 { type = mesh file = "../models/crafted/the_statue_Plaza_stone_6.obj" material = Crafted_Plaza_stone_6 position = (0, 0, 0) }
# END CRAFTED MODELS
body Statue { type = fractal_statue  radius = 0.3  depth = 4  ratio = 0.38  material = marble  pedestal = granite
              position = (0, 0, 0.24) }

# A hand magnifier (f = 250 mm) held 0.2 m from the statue's outer branch.
body HandLens { type = lens  medium = N-BK7  focal = 250mm  form = bi  diameter = 120mm  thickness = 16mm  rim = black
                position = (0.78, -0.13, 0.62)  look_at = (0.60, 0.0, 0.54) }

# The same telescope design as on the mountain, 60 m away, with the sun raking from the left.
body Scope { type = prescription  file = "../lenses/kepler_16x.lens"  afocal = true  tube = true
             position = (52, -30, 1.5)  point_at = (0.0, 0, 0.54) }

observer Direct    { position = (0.9, -2.0, 1.55)  look_at = (0.1, 0, 0.5)  fov = 32deg  pupil = 3mm  focus = 2.3
                     resolution = (480, 480) }
observer Close     { position = (1.02, 0.29, 0.73)  look_at = (0.60, 0.0, 0.54)  fov = 26deg  pupil = 3mm  focus = 0.52
                     resolution = (480, 480) }
observer Magnifier { position = (1.02, -0.29, 0.73)  look_at = (0.60, 0.0, 0.54)  fov = 26deg  pupil = 3mm  focus = 1.3
                     resolution = (480, 480) }
observer Telescope { position = exit_pupil("Scope")  look_at = (0.0, 0, 0.54)  fov = 36deg  pupil = 3mm  focus = 0.23
                     resolution = (480, 480) }

render { detector = Direct  spp = 128 }
