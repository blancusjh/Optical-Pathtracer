# THE KUNSTKAMMER — a quiet cabinet of curiosities, with the world measured in brass and steel.
# A low western sun enters one unglazed lattice: its bars divide the red carpet and rake the
# astrolabe's engraving. Steel returns the sun to plaster and flagstones by reflection and VCM
# merging; gilt holds the window in miniature. The gradient sky alone opens the shadows.
# References: Holbein, The Ambassadors (1533); Vermeer, The Astronomer (1668);
# Hammershoi, Interior with Sunlight on the Floor (1906). Ochre plaster, oxblood wool, dark oak.
# The requested collection spans centuries; this is a Renaissance-style museum arrangement,
# not a claim that the later telescope, sextant, prayer book and tellurium existed in 1533.
# CC BY: The Jagiellonian Globe — Virtual Museums of Małopolska
# https://sketchfab.com/3d-models/jagiellonian_globe-55a10e6015af4447a66f34b272d4bf1a
# CC BY: ETH: Tellurium with Lunarium — ETH Library_Collections
# https://sketchfab.com/3d-models/tellurium_lunarium-e4c9f36a40f3479885f27380f8286b2d
# CC0 acknowledgements: Cleveland Museum of Art; Virtual Museums of Małopolska / Collegium
# Maius and Wawel Royal Castle; Morbase | Museu Virtual; Varldskulturmuseerna / Medelhavsmuseet.
# Measurements and caveats are recorded in out/scenes/kunstkammer/report.txt.
units = m
world {
 sky = gradient(zenith = rgb(0.40, 0.57, 0.90, luminance = 0.8),
                horizon = rgb(0.94, 0.87, 0.72, luminance = 1.4),
                ground = rgb(0.20, 0.18, 0.14, luminance = 0.12))
 sun { elevation = 20deg azimuth = 285deg luminance = 1.2e5 temperature = 4800K nee_share = 1 }
}
material plaster { type = diffuse reflectance = rgb(0.66, 0.60, 0.47) relief = noise(scale = 3mm, depth = 0.12mm) }
material limestone { type = diffuse texture = noise(a = rgb(0.34,0.31,0.25), b = rgb(0.43,0.39,0.31), scale = 0.4) relief = noise(scale = 4mm, depth = 0.08mm) }
material walnut { type = diffuse texture = wood(a = rgb(0.10,0.052,0.025), b = rgb(0.055,0.029,0.014), scale = 5mm, turbulence = 0.3) }
material wool { type = diffuse texture = noise(a = rgb(0.29,0.027,0.021), b = rgb(0.13,0.013,0.010), scale = 0.022) relief = noise(scale = 1mm, depth = 0.05mm) }
material carpetGold { type = diffuse reflectance = rgb(0.43,0.25,0.09) }
material iron { type = conductor metal = silver tint = 0.55 roughness = 0.22 }
# Room: x +/-3, y +/-2.25, ceiling 4.3 m. Door is behind Room's eye.

body Floor { type = box size = (6, 4.5, 0.08) position = (0, 0, -0.0402) material = limestone  }
body Ceiling { type = box size = (6, 4.5, 0.1) position = (0, 0, 4.3502) material = plaster  }
body FarWall { type = box size = (6, 0.12, 4.3) position = (0, 2.3102, 2.15) material = plaster  }
body RightWall { type = box size = (0.12, 4.5, 4.3) position = (3.0602, 0, 2.15) material = plaster  }
body DoorWall { type = box size = (6, 0.12, 4.3) position = (0, -2.3102, 2.15) material = plaster  }
