body Rapier2 { type = mesh file = "../assets/sketchfab/rapier_mascarenhas/scene.gltf" part = "Steel" fit_height = 0.106741118 normals = file position = (2.74, 0.0, 1.1) rotate = (90, 0, -10) material = RapierMat2 }
# Single photographs cover mixed surfaces: armour includes red straps/plumes; globe its stand;
# telescope its dark tube; sextant its black case. Dominant metal chosen, baked lighting retained.
# Rapier on a wall rack: its scan is horizontal before the 90deg x turn.
body RapierRack { type = box size = (0.10,0.14,0.04) position = (2.85,0,1.20) material = walnut }
observer Room { position = (1.45,-2.03,1.6) look_at = (-.30,.70,1.6) up = (0,0,1) fov = 62deg pupil = 3mm focus = 3.3 resolution = (720,450) white_balance = 5200K }
observer Table { position = (.05,-1.80,1.52) look_at = (-.48,-.35,1.25) up = (0,0,1) fov = 38deg pupil = 3mm focus = 1.57 resolution = (640,400) white_balance = 5200K }
observer Armour { position = (-1.65,-1.18,1.6) look_at = (.75,1.10,1.6) up = (0,0,1) fov = 54deg pupil = 3mm focus = 3.31 resolution = (720,450) white_balance = 5200K }
observer Book { position = (-.92,-1.25,.94) look_at = (-.88,-.76,.695) up = (0,0,1) fov = 30deg pupil = 3mm focus = .55 resolution = (640,400) white_balance = 5200K }
# Sun glints need eye -> rough metal -> sun samples; manifold NEE is not implemented.
render { detector = Room spp = 128 integrator = vcm photons = 0.25 max_depth = 12 }

