# Wawel chest, ZKWawel 1558, CC0, Virtual Museums of Malopolska.
# https://sketchfab.com/3d-models/chest-c580f18e25b740e49ce8dd0f8cfd3247
# Native millimetre scan: 1.571 x .558 x .529m; retained uniformly.
material ChestWood { type = diffuse texture = image("../assets/sketchfab/wawel_chest/textures/material_diffuse.png", mapping = uv) roughness = .4  normal_map = image("../assets/sketchfab/wawel_chest/textures/material_normal.png", mapping = uv) normal_strength = .47 }
body HelmetChest { type = mesh file = "../assets/sketchfab/wawel_chest/scene.gltf" scale = .001 ground = true normals = file position = (2.25,-.12,0) rotate = (0,0,-7) material = ChestWood }

body Tablecloth { type = mesh file = "../models/crafted/the_kunstkammer_cloth.gltf" normals = smooth material = wool }
# A low oak cradle supports the astrolabe's rim and back, at its actual scale.
assembly AstrolabeCradle { position = (-1.67,-.98,1.0868) rotate = (0,0,-12)
 body Foot { type = box size = (.15,.095,.018) position = (0,.018,.009) material = furnitureOak }
 body Back { type = box size = (.035,.028,.16) position = (0,.041,.098) material = furnitureOak }
 body Lip { type = box size = (.075,.012,.026) position = (0,-.025,.031) material = furnitureOak }
}
