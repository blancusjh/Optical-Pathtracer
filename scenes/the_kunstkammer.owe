# DAYTIME ENVIRONMENT: Hosek-Wilkie atmospheric HDR, generated at this scene's
# exact solar elevation/azimuth. Sky only: the existing analytic sun supplies
# the sole solar disc. Turbidity2.4; diffuse horizontal irradiance=10% of DNI
# is an explicit clear-day assumption, not measured site/weather calibration.
# 4096x2048 original radiance maps and parameters: assets/daylight/MANIFEST.json.
# THE KUNSTKAMMER — steel in afternoon light.
# PLAN: Holbein, The Ambassadors (1533): oxblood cloth and brass in measured repose;
# Vermeer, The Astronomer (1668): one lateral window; Hammershoi, Interior with
# Sunlight on the Floor (1906): architectural shadow and quiet intervals.
# HERO: Cleveland's mounted armour, clear of the foreground table; western sunlight
# enters a deep stone window and strikes the steel. Brightest: breastplate and horse;
# darkest: table undercroft and cabinet recesses. Palette: ochre lime, fumed oak,
# red woven wool, silver and restrained gold. No artificial lights.
# ASSETS: museum scans below; Poly Haven white_plaster_02, oak_veneer_01,
# marble_01, quatrefoil_jacquard_fabric, GothicCabinet_01 and marble_bust_01
# (all CC0), plus the CC0 Wawel carved chest. Full normal/roughness maps used.
# Original full-resolution files are retained; the engine uses its default texture budget.
# This is a collected historical cabinet: the explicitly requested sextant and
# tellurium are later acquisitions, not claimed as Renaissance inventions.
# CC BY: The Jagiellonian Globe — Virtual Museums of Malopolska:
# https://sketchfab.com/3d-models/jagiellonian_globe-55a10e6015af4447a66f34b272d4bf1a
# CC BY: ETH Tellurium with Lunarium — ETH Library_Collections:
# https://sketchfab.com/3d-models/tellurium_lunarium-e4c9f36a40f3479885f27380f8286b2d
# Other museum scans CC0: Cleveland Museum of Art, Virtual Museums of Malopolska,
# Morbase / Museu Virtual, Varldskulturmuseerna. Sources: assets/sketchfab/MANIFEST.json.
# Native armour metre scale retained: museum supplies no overall dimensions.
units = m
world {
 sky = map("../assets/daylight/kunstkammer_sun_aligned.hdr", rotation = 0deg, scale = 1)
 sun { elevation = 16deg azimuth = 250deg luminance = 1.2e5 temperature = 5100K nee_share = .8 }
}

material plaster { type = diffuse texture = image("../assets/polyhaven/white_plaster_02/ochre.jpg", mapping = triplanar, scale = 2)  normal_map = image("../assets/polyhaven/white_plaster_02/white_plaster_02_nor_gl_8k.jpg", mapping = triplanar, scale = 2) normal_strength = .65 roughness_map = image("../assets/polyhaven/white_plaster_02/white_plaster_02_rough_8k.jpg", mapping = triplanar, scale = 2) }
material limestone { type = diffuse texture = image("../assets/polyhaven/marble_01/marble_01_diff_8k.jpg", mapping = triplanar, scale = 1.4) roughness = .65  normal_map = image("../assets/polyhaven/marble_01/marble_01_nor_gl_8k.jpg", mapping = triplanar, scale = 1.4) normal_strength = .65 roughness_map = image("../assets/polyhaven/marble_01/marble_01_rough_8k.jpg", mapping = triplanar, scale = 1.4) }
material walnut { type = diffuse texture = image("../assets/polyhaven/oak_veneer_01/fumed.jpg", mapping = triplanar, scale = 1.8) roughness = .35  normal_map = image("../assets/polyhaven/oak_veneer_01/oak_veneer_01_nor_gl_16k.jpg", mapping = triplanar, scale = 1.8) normal_strength = .65 roughness_map = image("../assets/polyhaven/oak_veneer_01/oak_veneer_01_rough_16k.jpg", mapping = triplanar, scale = 1.8) }
material furnitureOak { type = diffuse texture = image("../assets/polyhaven/oak_veneer_01/fumed.jpg", mapping = triplanar, scale = .8) roughness = .35  normal_map = image("../assets/polyhaven/oak_veneer_01/oak_veneer_01_nor_gl_16k.jpg", mapping = triplanar, scale = .8) normal_strength = .65 roughness_map = image("../assets/polyhaven/oak_veneer_01/oak_veneer_01_rough_16k.jpg", mapping = triplanar, scale = .8) }
material wool { type = diffuse texture = image("../assets/polyhaven/quatrefoil_jacquard_fabric/oxblood_8k.jpg", mapping = uv)  normal_map = image("../assets/polyhaven/quatrefoil_jacquard_fabric/quatrefoil_jacquard_fabric_nor_gl_8k.jpg", mapping = uv, scale = 1) normal_strength = .65 roughness_map = image("../assets/polyhaven/quatrefoil_jacquard_fabric/quatrefoil_jacquard_fabric_rough_8k.jpg", mapping = uv, scale = 1) }
material carpetGold { type = diffuse reflectance = rgb(.25,.13,.045) }
material iron { type = conductor metal = silver tint = .35 roughness = .32 }
material ArmourMat0 { type = conductor metal = silver roughness = 0.19 texture = image("../assets/sketchfab/armor_man_and_horse/textures/steel_reflectance.jpg", mapping = uv)  normal_map = image("../assets/sketchfab/armor_man_and_horse/textures/Armor_Mat_normal.jpeg", mapping = uv) roughness_map = image("../assets/sketchfab/armor_man_and_horse/textures/polished_steel_roughness.png", mapping = uv) }
material HelmetMat0 { type = conductor metal = silver roughness = 0.10 texture = image("../assets/sketchfab/closed_helmet/textures/wire_006134006_baseColor.jpeg", mapping = uv)  normal_map = image("../assets/sketchfab/closed_helmet/textures/wire_006134006_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/closed_helmet/textures/wire_006134006_metallicRoughness.png", mapping = uv) }
material AstrolabeMat0 { type = conductor metal = gold roughness = 0.22 texture = image("../assets/sketchfab/astrolabe/textures/Default_OBJ_baseColor.jpeg", mapping = uv)  normal_map = image("../assets/sketchfab/astrolabe/textures/Default_OBJ_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/astrolabe/textures/Default_OBJ_metallicRoughness.png", mapping = uv) }
material GlobeMat0 { type = conductor metal = gold roughness = 0.16 texture = image("../assets/sketchfab/jagiellonian_globe/textures/MUJ_798_I_Globus_Jagiellonski_u1_v1_baseColor.png", mapping = uv)  }
material SextantMat0 { type = conductor metal = gold roughness = 0.22 texture = image("../assets/sketchfab/pocket_sextant/textures/17231_2255_V_Sekstant_kieszonkowy_07_FIN_baseColor.png", mapping = uv)  normal_map = image("../assets/sketchfab/pocket_sextant/textures/17231_2255_V_Sekstant_kieszonkowy_07_FIN_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/pocket_sextant/textures/17231_2255_V_Sekstant_kieszonkowy_07_FIN_metallicRoughness.png", mapping = uv) }
material SextantMat1 { type = conductor metal = gold roughness = 0.22 tint = 0.55 }
material BookMat0 { type = diffuse texture = image("../assets/sketchfab/coptic_prayer_book/textures/material0_baseColor.png", mapping = uv)  normal_map = image("../assets/sketchfab/coptic_prayer_book/textures/material0_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/coptic_prayer_book/textures/material0_metallicRoughness.png", mapping = uv) }
material TelluriumMat0 { type = diffuse texture = image("../assets/sketchfab/tellurium_lunarium/textures/KGS-001-x_baseColor.jpeg", mapping = uv)  roughness_map = image("../assets/sketchfab/tellurium_lunarium/textures/KGS-001-x_metallicRoughness.png", mapping = uv) }
material TelluriumMat1 { type = diffuse texture = image("../assets/sketchfab/tellurium_lunarium/textures/KGS-001-x_Elemente_baseColor.jpeg", mapping = uv)  roughness_map = image("../assets/sketchfab/tellurium_lunarium/textures/KGS-001-x_metallicRoughness.png", mapping = uv) }
material RapierMat0 { type = conductor metal = gold roughness = 0.16 texture = image("../assets/sketchfab/rapier_mascarenhas/textures/Gold_baseColor.png", mapping = uv)  normal_map = image("../assets/sketchfab/rapier_mascarenhas/textures/Gold_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/rapier_mascarenhas/textures/Gold_metallicRoughness.png", mapping = uv) }
material RapierMat1 { type = conductor metal = silver roughness = 0.10 texture = image("../assets/sketchfab/rapier_mascarenhas/textures/Silver_baseColor.png", mapping = uv)  normal_map = image("../assets/sketchfab/rapier_mascarenhas/textures/Silver_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/rapier_mascarenhas/textures/Silver_metallicRoughness.png", mapping = uv) }
material RapierMat2 { type = conductor metal = silver roughness = 0.10 texture = image("../assets/sketchfab/rapier_mascarenhas/textures/Steel_baseColor.png", mapping = uv)  normal_map = image("../assets/sketchfab/rapier_mascarenhas/textures/Steel_normal.png", mapping = uv) roughness_map = image("../assets/sketchfab/rapier_mascarenhas/textures/Steel_metallicRoughness.png", mapping = uv) }
material CabinetWood { type = diffuse texture = image("../assets/polyhaven/GothicCabinet_01/textures/GothicCabinet_01_diff_4k.jpg", mapping = uv) roughness = .4  normal_map = image("../assets/polyhaven/GothicCabinet_01/textures/GothicCabinet_01_nor_gl_4k.jpg", mapping = uv, scale = 1) normal_strength = .65 roughness_map = image("../assets/polyhaven/GothicCabinet_01/textures/GothicCabinet_01_arm_4k.jpg", mapping = uv, scale = 1) }
