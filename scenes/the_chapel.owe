# THE CHAPEL — late sun, amber and lapis glass, worn limestone, silence.
# An imagined full-height Gothic chapel under the Beauvais transept vault;
# a curated architectural assemblage, not a reconstruction of any one cathedral.
# First notice the pool of transmitted colour and its ascent onto a clustered pier.
# Foreground flags lead into that middle-ground accent; the vault recedes in shadow.
# References: Frederick H. Evans, A Sea of Steps, Wells Cathedral (1903),
# https://collections.lacma.org/object/145259 — stone values and measured framing;
# Vilhelm Hammershoi, Interior in Strandgade, Sunlight on the Floor (1901),
# https://open.smk.dk/en/artwork/image/KMS3696 — empty space, low chroma, window light.
# No candles: the late sun is the only dominant source; the sky supplies real fill.
# CC BY assets (all photographs are mapped with the scan's own UV coordinates):
# Beauvais vault — Zoilo, https://sketchfab.com/3d-models/beauvais_vault-939ab33fef8c421888dbe7eba15ff1fc
# Valencia rose — egiptologo91, https://sketchfab.com/3d-models/valencia_rose_window-628a1dba139849b282f7280feec1f2a0
# Southwark lancet — Thomas Flynn, https://sketchfab.com/3d-models/southwark_stained_glass-9f24973fc9c344539a6105a1e7357fb4
# Scale: Beauvais scanned portion spans raw z=6.43532..48.48244; fit only that
# 42.04712m span, then restore its 6.43532m floor datum. Never fit a fragment to 48m.
# https://cathedrale-beauvais.fr/en/history-of-beauvais-cathedral/ (48.5m transept).
# Valencia aperture 6.5m: https://mural.uv.es/camblas/castella/monums/catedral/catedral.htm
# Its measured aperture spans 21.7954 scan units, whole scan height 33.8255:
# fit_height=10.0877m preserves the 6.5m aperture and surrounding stone.
# Southwark scale PROVISIONAL: no measured dimension tied to this scan was found.
# 1m clear width gives 6.99128m whole scan height. Replace after archival verification.
# The main Southwark part mixes glass and carved stone; NONE is exporter backing,
# with black baseColorFactor and only 1024 vertices spanning the entire scan.
# Omit NONE: it closes the aperture. A mask, not a part-name guess, identifies glass.
# Paths resolve relative to this scene file, including inside material calls.
#
# STEPWISE REFINEMENT / REQUIRED OPTICS (normative specification in chapel_spec.txt):
# 1. Thin-slab stained_glass: two-face Fresnel, incoherent internal reflections,
#    straight transmission; UV photograph gives normal-incidence internal tau.
#    Explicit glass_mask delegates stone to stone_material; never turns it into glass.
# 2. Existing homogeneous medium syntax, with VCM/SPPM volume transport enabled.
# No third feature. haze=0 on panes preserves straight sun visibility; the real
# solar disc provides penumbrae. Incense alone makes coloured shafts visible.
units = m

# BEGIN MEDIUM
medium Incense { base = air  absorption = 0.00015  scattering = 0.004  g = 0.55 }
# END MEDIUM
world {
    medium = air
    sky = gradient(zenith = rgb(0.36, 0.48, 0.70, luminance = 0.35),
                   horizon = rgb(0.78, 0.73, 0.65, luminance = 0.70),
                   ground = rgb(0.28, 0.26, 0.23, luminance = 0.10))
    sun { elevation = 25deg  azimuth = 235deg  angular_diameter = 0.533deg
          temperature = 4800K  luminance = 1.2e5  nee_share = 1 }
}

material Limestone { type = diffuse  reflectance = rgb(0.54, 0.51, 0.44)
    relief = noise(scale = 6mm, depth = 0.18mm) }
material Flags { type = diffuse
    texture = noise(a = rgb(0.39, 0.37, 0.32), b = rgb(0.50, 0.47, 0.40), scale = 0.65)
    roughness = (0.62, 0.78)  relief = noise(scale = 9mm, depth = 0.24mm) }
material Joint { type = diffuse  reflectance = rgb(0.18, 0.17, 0.15) }
material Vault0 { type = diffuse  texture = image("../assets/sketchfab/beauvais_vault/textures/Model_0_baseColor.jpeg", mapping = uv) }
material Vault1 { type = diffuse  texture = image("../assets/sketchfab/beauvais_vault/textures/Model_1_baseColor.jpeg", mapping = uv) }
material RoseStone { type = diffuse  texture = image("../assets/sketchfab/valencia_rose_window/textures/Material_0_baseColor.jpeg", mapping = uv) }
material LancetStone { type = diffuse  texture = image("../assets/sketchfab/southwark_stained_glass/textures/cathedral-window_Material_u1_v1_baseColor.jpeg", mapping = uv) }

# BEGIN GLASS RoseGlass
material RoseGlass { type = stained_glass
    transmittance = image("../assets/sketchfab/valencia_rose_window/textures/Material_0_baseColor.jpeg", mapping = uv)
    gain = 1.8  density = 0.85  thickness = 3mm  index = constant(1.52)  haze = 0
    glass_mask = image("chapel_assets/valencia_rose_window_glass_mask.png", mapping = uv)
    mask_threshold = 0.5  stone_material = RoseStone }
# END GLASS
# BEGIN GLASS LancetGlass
material LancetGlass { type = stained_glass
    transmittance = image("../assets/sketchfab/southwark_stained_glass/textures/cathedral-window_Material_u1_v1_baseColor.jpeg", mapping = uv)
    gain = 0.9  density = 1.10  thickness = 3mm  index = constant(1.52)  haze = 0
    glass_mask = image("chapel_assets/southwark_stained_glass_glass_mask.png", mapping = uv)
    mask_threshold = 0.5  stone_material = LancetStone }
# END GLASS

# BEGIN VOLUME
body IncenseVolume { type = box size = (40, 51, 49.8) position = (0,0,24.8) medium = Incense surface = null }
# END VOLUME

body VaultA { in = IncenseVolume type = mesh  file = "../assets/sketchfab/beauvais_vault/scene.gltf"
    part = "Model_0"  model_up = (0.04960653, 0.02555055, 0.99844197)
    fit_height = 42.04712  rotate = (0, 0, 77.601944)  position = (0, 0, 6.43532)
    normals = smooth(crease = 65deg)  material = Vault0 }
body VaultB { in = IncenseVolume type = mesh  file = "../assets/sketchfab/beauvais_vault/scene.gltf"
    part = "Model_1"  model_up = (0.04960653, 0.02555055, 0.99844197)
    fit_height = 42.04712  rotate = (0, 0, 77.601944)  position = (0, 0, 6.43532)
    normals = smooth(crease = 65deg)  material = Vault1 }

# The scan retains its ashlar and deep reveals; wall openings admit that entire
# patch, while the mask admits light only through actual glass. West is -y;
# south is -x. The assembly's north/east are deliberately in deep shadow.
# The circular backing reveal blocks missing exterior scan patches; it is real stone.
body RoseReveal { in = IncenseVolume type = disk radius = 10 inner_radius = 3.25
    position = (-0.124, -23.48, 15.13) axis = (0,1,0) up = (0,0,1) material = Limestone }
body Rose { in = IncenseVolume type = mesh  file = "../assets/sketchfab/valencia_rose_window/scene.gltf"
    part = "Material_0"  fit_height = 10.0877  position = (0, -24.15, 9.5)
    normals = file  material = RoseGlass }
body LancetA { in = IncenseVolume type = mesh  file = "../assets/sketchfab/southwark_stained_glass/scene.gltf"
    part = "cathedral-window_Material_u1_v1"  fit_height = 6.99128
    rotate = (0, 0, -90)  position = (-18.40, -9.0, 1.8)
    normals = file  material = LancetGlass }
body LancetB { in = IncenseVolume type = mesh  file = "../assets/sketchfab/southwark_stained_glass/scene.gltf"
    part = "cathedral-window_Material_u1_v1"  fit_height = 6.99128
    rotate = (0, 0, -90)  position = (-18.40, -1.0, 1.8)
    normals = file  material = LancetGlass }

# Stone flags are actual separate slabs, with recessed joints, not a checker.
body FlagRow0 { in = IncenseVolume type = box size = (1.194,0.994,0.09) position = (-17.4,-23,-0.045) repeat = (30,(1.2,0,0)) material = Flags }
