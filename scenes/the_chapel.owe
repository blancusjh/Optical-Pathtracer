body Bedding { in = IncenseVolume type = box  size = (36, 47, 0.18)  position = (0, 0, -0.18)  material = Joint }
body NorthWall { in = IncenseVolume type = box size = (0.65, 47, 48.5) position = (18.125, 0, 24.25) material = Limestone }
body EastWall { in = IncenseVolume type = box size = (36.25, 0.65, 48.5) position = (0, 23.825, 24.25) material = Limestone }
body WestLeft { in = IncenseVolume type = box size = (10.6, 0.65, 48.5) position = (-12.7, -23.825, 24.25) material = Limestone }
body WestRight { in = IncenseVolume type = box size = (10.6, 0.65, 48.5) position = (12.7, -23.825, 24.25) material = Limestone }
body WestBelow { in = IncenseVolume type = box size = (14.8, 0.65, 9.5) position = (0, -23.825, 4.75) material = Limestone }
body WestAbove { in = IncenseVolume type = box size = (14.8, 0.65, 28.913) position = (0, -23.825, 34.0435) material = Limestone }
body SouthJamb0 { in = IncenseVolume type = box size = (0.65, 13.15, 48.5) position = (-18.125, -16.925, 24.25) material = Limestone }
body SouthJamb1 { in = IncenseVolume type = box size = (0.65, 5.300000000000001, 48.5) position = (-18.125, -5.0, 24.25) material = Limestone }
body SouthJamb2 { in = IncenseVolume type = box size = (0.65, 23.15, 48.5) position = (-18.125, 11.925, 24.25) material = Limestone }
body SouthSill0 { in = IncenseVolume type = box size = (0.65, 2.7, 1.8) position = (-18.125, -9, 0.9) material = Limestone }
body SouthHead0 { in = IncenseVolume type = box size = (0.65, 2.7, 39.70872) position = (-18.125, -9, 28.64564) material = Limestone }
body SouthSill1 { in = IncenseVolume type = box size = (0.65, 2.7, 1.8) position = (-18.125, -1, 0.9) material = Limestone }
body SouthHead1 { in = IncenseVolume type = box size = (0.65, 2.7, 39.70872) position = (-18.125, -1, 28.64564) material = Limestone }
assembly Pier1 { position = (-10.635,4.364,0.0005)
 body Pier1_Plinth { in = IncenseVolume type = cylinder radius = 1.35 height = 0.22 material = Limestone }
 body Pier1_TorusBase { in = IncenseVolume type = torus radius = 1.00 tube_radius = 0.12 position = (0,0,0.34) material = Limestone }
 body Pier1_Core { in = IncenseVolume type = cylinder radius = 0.87 height = 6.21432 position = (0,0,0.2205) material = Limestone }
 body Pier1_Shaft0 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (1.09000,0.00000,0.4605) material = Limestone }
 body Pier1_Shaft1 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (0.77075,0.77075,0.4605) material = Limestone }
 body Pier1_Shaft2 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (0.00000,1.09000,0.4605) material = Limestone }
 body Pier1_Shaft3 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (-0.77075,0.77075,0.4605) material = Limestone }
 body Pier1_Shaft4 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (-1.09000,0.00000,0.4605) material = Limestone }
 body Pier1_Shaft5 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (-0.77075,-0.77075,0.4605) material = Limestone }
 body Pier1_Shaft6 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (-0.00000,-1.09000,0.4605) material = Limestone }
 body Pier1_Shaft7 { in = IncenseVolume type = cylinder radius = 0.20 height = 5.97432 position = (0.77075,-0.77075,0.4605) material = Limestone }
}

# Level Nave view: dark near pier frames flags, two lancets and the coloured pool.
observer Nave { position = (9, 22, 1.65) look_at = (-6, -10, 1.65) up = (0,0,1)
    fov = 50deg pupil = 3.5mm focus = 35.34 resolution = (960,600) white_balance = 5200K tone = agx }
observer Floor { position = (-6, -8, 4) look_at = (-9, -3, 0) up = (0,0,1)
    fov = 38deg pupil = 3.5mm focus = 7.071 resolution = (960,600) white_balance = 5200K tone = agx }
observer Rose { position = (0, -7.0, 1.65) look_at = (0, -22.95, 15.1) up = (0,0,1)
    fov = 32deg pupil = 3.5mm focus = 20.87 resolution = (960,600) white_balance = 5200K tone = agx }
observer Shafts { position = (8, -13, 1.65) look_at = (-10, -2.0, 5.0) up = (0,0,1)
    fov = 55deg pupil = 3.5mm focus = 21.36 resolution = (960,600) white_balance = 5200K tone = agx }
# Four light subpaths/pixel/iteration for this large bay; thin direct colour
# needs no caustic photons. Retain VCM merging for indirect stone and the volume.
render { detector = Nave integrator = vcm spp = 256 photons = 4
    max_depth = 12 photon_radius = 2 photon_alpha = 0.6666667 vcm_groups = 1 }
