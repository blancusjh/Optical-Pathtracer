# END CRAFTED MODELS

# BEGIN LANDSCAPE MODELS
# Generated by tools/build_landscapes.py; existing materials, metres, world coordinates.
body Landscape_Ground_relief { type = mesh file = "../models/landscapes/the_observatory_Ground_relief.obj" material = rock position = (0, 0, 0.0005) }
body Landscape_Hillside_outcrops { type = mesh file = "../models/landscapes/the_observatory_Hillside_outcrops.obj" material = rock position = (0, 0, 0.0005) }
# END LANDSCAPE MODELS

# ---------------------------------------------------------------- observers
observer Room { position = on_terrain("Ground", 3.7, -0.3, 1.66)  look_at = on_terrain("Ground", -1.6, 0.9, 1.75)
                fov = 80deg  pupil = 5mm  focus = 3.5  resolution = (800, 500) }
observer Desk { position = on_terrain("Ground", 1.25, 2.38, 1.2)  look_at = on_terrain("Ground", 1.2, 3.32, 0.88)
                fov = 52deg  pupil = 5mm  focus = 1.05  resolution = (720, 480) }
# Through the eyepieces: the planets are sunlit, so these views keep daylight white and a fixed
# exposure (the black sky would otherwise be raised to mid-grey), and give the sun 97% of the light
# samples (the candles behind the observer contribute almost nothing here).
observer SaturnEyepiece  { position = exit_pupil("GreatRefractor")  look_at = sky(176deg, 33deg, 1.28e12)
                           fov = 4deg  pupil = 1.1mm  resolution = (480, 480)
                           exposure = 5  white_balance = none  sun_share = 0.97 }
observer JupiterEyepiece { position = exit_pupil("Refractor2")  look_at = sky(164deg, 38deg, 6.3e11)
                           fov = 4deg  pupil = 1.1mm  resolution = (480, 480)
                           exposure = 2.6  white_balance = none  sun_share = 0.97 }
observer MoonEyepiece    { position = exit_pupil("MoonScope")  look_at = sky(250deg, 24deg, 3.844e8)
                           fov = 38deg  pupil = 3mm  resolution = (480, 480)
                           exposure = 1.3  white_balance = none  sun_share = 0.97 }
observer Slit { position = on_terrain("Ground", 0.1, 1.9, 1.6)  look_at = sky(170deg, 42deg, 100)
                fov = 64deg  pupil = 6mm  resolution = (640, 640) }

# Neutral display white: free exploration also includes the outdoor sky and sunlit planets.
# A fixed candlelight correction must not follow the observer out into daylight-coloured light.
# Guide some diffuse continuations toward the Moon to resolve reflected moonlight.
# This changes sampling variance only: the rays still hit its actual surface, scatter,
# and trace visibility to the sun. The other half retains full hemisphere support.
render { detector = Room  spp = 256  white_balance = none  indirect_guide = Moon }
