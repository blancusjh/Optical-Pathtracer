material Crafted_Limestone_4 { type = diffuse texture = noise(a = rgb(0.6013, 0.5486, 0.4536), b = rgb(0.5472, 0.4992, 0.4128), scale = 0.028) }
body Crafted_Limestone_4 { type = mesh file = "../models/crafted/the_temple_Limestone_4.obj" material = Crafted_Limestone_4 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Limestone_5 { type = diffuse texture = noise(a = rgb(0.6327, 0.5772, 0.4773), b = rgb(0.5758, 0.5253, 0.4343), scale = 0.028) }
body Crafted_Limestone_5 { type = mesh file = "../models/crafted/the_temple_Limestone_5.obj" material = Crafted_Limestone_5 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Limestone_6 { type = diffuse texture = noise(a = rgb(0.6640, 0.6058, 0.5010), b = rgb(0.6043, 0.5513, 0.4559), scale = 0.028) }
body Crafted_Limestone_6 { type = mesh file = "../models/crafted/the_temple_Limestone_6.obj" material = Crafted_Limestone_6 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Cypress_bark { type = diffuse texture = noise(a = rgb(0.2200, 0.1900, 0.1350), b = rgb(0.2002, 0.1729, 0.1229), scale = 0.028) }
body Crafted_Cypress_bark { type = mesh file = "../models/crafted/the_temple_Cypress_bark.obj" material = Crafted_Cypress_bark position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Cypress_sprays_0 { type = diffuse texture = noise(a = rgb(0.0646, 0.1216, 0.0494), b = rgb(0.0588, 0.1107, 0.0450), scale = 0.028) }
body Crafted_Cypress_sprays_0 { type = mesh file = "../models/crafted/the_temple_Cypress_sprays_0.obj" material = Crafted_Cypress_sprays_0 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Cypress_sprays_1 { type = diffuse texture = noise(a = rgb(0.0748, 0.1408, 0.0572), b = rgb(0.0681, 0.1281, 0.0521), scale = 0.028) }
body Crafted_Cypress_sprays_1 { type = mesh file = "../models/crafted/the_temple_Cypress_sprays_1.obj" material = Crafted_Cypress_sprays_1 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Cypress_sprays_2 { type = diffuse texture = noise(a = rgb(0.0850, 0.1600, 0.0650), b = rgb(0.0774, 0.1456, 0.0592), scale = 0.028) }
body Crafted_Cypress_sprays_2 { type = mesh file = "../models/crafted/the_temple_Cypress_sprays_2.obj" material = Crafted_Cypress_sprays_2 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Cypress_sprays_3 { type = diffuse texture = noise(a = rgb(0.0952, 0.1792, 0.0728), b = rgb(0.0866, 0.1631, 0.0662), scale = 0.028) }
body Crafted_Cypress_sprays_3 { type = mesh file = "../models/crafted/the_temple_Cypress_sprays_3.obj" material = Crafted_Cypress_sprays_3 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Cypress_sprays_4 { type = diffuse texture = noise(a = rgb(0.1054, 0.1984, 0.0806), b = rgb(0.0959, 0.1805, 0.0733), scale = 0.028) }
body Crafted_Cypress_sprays_4 { type = mesh file = "../models/crafted/the_temple_Cypress_sprays_4.obj" material = Crafted_Cypress_sprays_4 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_bark { type = diffuse texture = noise(a = rgb(0.2650, 0.2250, 0.1750), b = rgb(0.2412, 0.2048, 0.1593), scale = 0.028) }
body Crafted_Olive_bark { type = mesh file = "../models/crafted/the_temple_Olive_bark.obj" material = Crafted_Olive_bark position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_twigs { type = diffuse texture = noise(a = rgb(0.2500, 0.2150, 0.1450), b = rgb(0.2275, 0.1956, 0.1319), scale = 0.028) }
body Crafted_Olive_twigs { type = mesh file = "../models/crafted/the_temple_Olive_twigs.obj" material = Crafted_Olive_twigs position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaves_0 { type = diffuse texture = noise(a = rgb(0.1837, 0.2363, 0.1200), b = rgb(0.1672, 0.2150, 0.1092), scale = 0.028) }
body Crafted_Olive_leaves_0 { type = mesh file = "../models/crafted/the_temple_Olive_leaves_0.obj" material = Crafted_Olive_leaves_0 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaves_1 { type = diffuse texture = noise(a = rgb(0.2082, 0.2677, 0.1360), b = rgb(0.1895, 0.2437, 0.1238), scale = 0.028) }
body Crafted_Olive_leaves_1 { type = mesh file = "../models/crafted/the_temple_Olive_leaves_1.obj" material = Crafted_Olive_leaves_1 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaves_2 { type = diffuse texture = noise(a = rgb(0.2327, 0.2992, 0.1520), b = rgb(0.2118, 0.2723, 0.1383), scale = 0.028) }
body Crafted_Olive_leaves_2 { type = mesh file = "../models/crafted/the_temple_Olive_leaves_2.obj" material = Crafted_Olive_leaves_2 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaves_3 { type = diffuse texture = noise(a = rgb(0.2572, 0.3308, 0.1680), b = rgb(0.2341, 0.3010, 0.1529), scale = 0.028) }
body Crafted_Olive_leaves_3 { type = mesh file = "../models/crafted/the_temple_Olive_leaves_3.obj" material = Crafted_Olive_leaves_3 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaves_4 { type = diffuse texture = noise(a = rgb(0.2818, 0.3622, 0.1840), b = rgb(0.2564, 0.3296, 0.1674), scale = 0.028) }
body Crafted_Olive_leaves_4 { type = mesh file = "../models/crafted/the_temple_Olive_leaves_4.obj" material = Crafted_Olive_leaves_4 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaves_5 { type = diffuse texture = noise(a = rgb(0.3063, 0.3937, 0.2000), b = rgb(0.2787, 0.3583, 0.1820), scale = 0.028) }
body Crafted_Olive_leaves_5 { type = mesh file = "../models/crafted/the_temple_Olive_leaves_5.obj" material = Crafted_Olive_leaves_5 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Olive_leaf_silver { type = diffuse texture = noise(a = rgb(0.3900, 0.4200, 0.2900), b = rgb(0.3549, 0.3822, 0.2639), scale = 0.028) }
body Crafted_Olive_leaf_silver { type = mesh file = "../models/crafted/the_temple_Olive_leaf_silver.obj" material = Crafted_Olive_leaf_silver position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Carved_marble { type = diffuse texture = noise(a = rgb(0.7600, 0.7200, 0.6300), b = rgb(0.6916, 0.6552, 0.5733), scale = 0.028) }
body Crafted_Carved_marble { type = mesh file = "../models/crafted/the_temple_Carved_marble.obj" material = Crafted_Carved_marble position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Frieze_recess { type = diffuse texture = noise(a = rgb(0.4500, 0.4250, 0.3700), b = rgb(0.4095, 0.3867, 0.3367), scale = 0.028) }
body Crafted_Frieze_recess { type = mesh file = "../models/crafted/the_temple_Frieze_recess.obj" material = Crafted_Frieze_recess position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Roof_terracotta_0 { type = diffuse texture = noise(a = rgb(0.4176, 0.2479, 0.1479), b = rgb(0.3800, 0.2256, 0.1346), scale = 0.028) }
body Crafted_Roof_terracotta_0 { type = mesh file = "../models/crafted/the_temple_Roof_terracotta_0.obj" material = Crafted_Roof_terracotta_0 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Roof_terracotta_1 { type = diffuse texture = noise(a = rgb(0.4488, 0.2665, 0.1590), b = rgb(0.4084, 0.2425, 0.1446), scale = 0.028) }
body Crafted_Roof_terracotta_1 { type = mesh file = "../models/crafted/the_temple_Roof_terracotta_1.obj" material = Crafted_Roof_terracotta_1 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Roof_terracotta_2 { type = diffuse texture = noise(a = rgb(0.4800, 0.2850, 0.1700), b = rgb(0.4368, 0.2593, 0.1547), scale = 0.028) }
body Crafted_Roof_terracotta_2 { type = mesh file = "../models/crafted/the_temple_Roof_terracotta_2.obj" material = Crafted_Roof_terracotta_2 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Roof_terracotta_3 { type = diffuse texture = noise(a = rgb(0.5112, 0.3035, 0.1811), b = rgb(0.4652, 0.2762, 0.1648), scale = 0.028) }
body Crafted_Roof_terracotta_3 { type = mesh file = "../models/crafted/the_temple_Roof_terracotta_3.obj" material = Crafted_Roof_terracotta_3 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Roof_terracotta_4 { type = diffuse texture = noise(a = rgb(0.5424, 0.3220, 0.1921), b = rgb(0.4936, 0.2931, 0.1748), scale = 0.028) }
body Crafted_Roof_terracotta_4 { type = mesh file = "../models/crafted/the_temple_Roof_terracotta_4.obj" material = Crafted_Roof_terracotta_4 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Dry_grass_0 { type = diffuse texture = noise(a = rgb(0.2816, 0.2816, 0.1320), b = rgb(0.2563, 0.2563, 0.1201), scale = 0.028) }
body Crafted_Dry_grass_0 { type = mesh file = "../models/crafted/the_temple_Dry_grass_0.obj" material = Crafted_Dry_grass_0 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Dry_grass_1 { type = diffuse texture = noise(a = rgb(0.3200, 0.3200, 0.1500), b = rgb(0.2912, 0.2912, 0.1365), scale = 0.028) }
body Crafted_Dry_grass_1 { type = mesh file = "../models/crafted/the_temple_Dry_grass_1.obj" material = Crafted_Dry_grass_1 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Dry_grass_2 { type = diffuse texture = noise(a = rgb(0.3584, 0.3584, 0.1680), b = rgb(0.3261, 0.3261, 0.1529), scale = 0.028) }
body Crafted_Dry_grass_2 { type = mesh file = "../models/crafted/the_temple_Dry_grass_2.obj" material = Crafted_Dry_grass_2 position = on_terrain("Ground", 0, 0, 0) }
material Crafted_Amphora_handles { type = diffuse texture = noise(a = rgb(0.5300, 0.2750, 0.1400), b = rgb(0.4823, 0.2503, 0.1274), scale = 0.028) }
body Crafted_Amphora_handles { type = mesh file = "../models/crafted/the_temple_Amphora_handles.obj" material = Crafted_Amphora_handles position = on_terrain("Ground", 0, 0, 0) }
# END CRAFTED MODELS

# BEGIN LANDSCAPE MODELS
# Generated by tools/build_landscapes.py; existing materials, metres, world coordinates.
body Landscape_Ground_relief { type = mesh file = "../models/landscapes/the_temple_Ground_relief.obj" material = hillside normals = smooth position = (0, 0, 0.0005) }
body Landscape_Limestone_outcrops { type = mesh file = "../models/landscapes/the_temple_Limestone_outcrops.obj" material = hillside normals = smooth position = (0, 0, 0.0005) }
body Landscape_Dry_tussocks { type = mesh file = "../models/landscapes/the_temple_Dry_tussocks.obj" material = olive normals = smooth position = (0, 0, 0.0005) }
# END LANDSCAPE MODELS

# ---------------------------------------------------------------- observers
camera Cam { lens = "../lenses/portrait_85mm.lens"  sensor = (36mm, 24mm)  resolution = (600, 400)
             position = on_terrain("Ground", -1.9, -8.2, 1.55)  look_at = on_terrain("Ground", 0.35, 3.5, 2.4)
             focus = 11.95  f_number = 2.0 }

observer Wide { position = on_terrain("Ground", -16, -24, 3.2)  look_at = on_terrain("Ground", 1, 17, 4.5)
                fov = 46deg  pupil = 3mm  focus = 40  resolution = (720, 450) }

# From the south-west corner of the precinct, along the sunlit west colonnade.
observer Colonnade { position = on_terrain("Ground", -11.5, 3.5, 1.7)  look_at = on_terrain("Ground", -6.2, 22, 4.2)
                     fov = 50deg  pupil = 3mm  focus = 12  resolution = (720, 480) }

render { detector = Wide  spp = 128 }
