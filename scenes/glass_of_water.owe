# THE GLASS OF WATER — refraction, absorption, reflection and caustics in a domestic scene.
# A drinking glass (N-BK7) holds water (Daimon–Masumura dispersion, Pope–Fry absorption);
# a red rod stands in it. The rod appears broken at the water line and the striped card
# behind is compressed by the water cylinder — nothing is faked, it is Snell's law applied
# at every glass–air, glass–water and water–air boundary. Hybrid estimator for the caustic.
units = m

world {
    sky = gradient(zenith = rgb(0.9, 0.93, 1.0, luminance = 0.35), horizon = rgb(1.0, 0.97, 0.92, luminance = 0.45),
                   ground = rgb(0.4, 0.35, 0.3, luminance = 0.1))
}

material oak     { type = diffuse  texture = rings(a = rgb(0.58, 0.40, 0.24), b = rgb(0.40, 0.25, 0.13), scale = 4mm, turbulence = 0.4) }
material stripes { type = diffuse  texture = checker(a = rgb(0.9, 0.9, 0.88), b = rgb(0.08, 0.10, 0.25), scale = 6mm) }
material red     { type = diffuse  reflectance = rgb(0.80, 0.10, 0.06) }

body Table { type = box  size = (1.2, 0.8, 0.03)  position = (0, 0.1, -0.018)  material = oak }
# BEGIN CRAFTED MODELS
# Generated by tools/build_scene_models.py; edit its recipes to regenerate.
material Crafted_Table_boards_0 { type = diffuse texture = noise(a = rgb(0.3623, 0.2199, 0.1121), b = rgb(0.3296, 0.2001, 0.1020), scale = 0.028) }
body Crafted_Table_boards_0 { type = mesh file = "../models/crafted/glass_of_water_Table_boards_0.obj" material = Crafted_Table_boards_0 position = (0, 0, 0) }
material Crafted_Table_boards_1 { type = diffuse texture = noise(a = rgb(0.3853, 0.2340, 0.1193), b = rgb(0.3507, 0.2129, 0.1085), scale = 0.028) }
body Crafted_Table_boards_1 { type = mesh file = "../models/crafted/glass_of_water_Table_boards_1.obj" material = Crafted_Table_boards_1 position = (0, 0, 0) }
material Crafted_Table_boards_2 { type = diffuse texture = noise(a = rgb(0.4084, 0.2480, 0.1264), b = rgb(0.3717, 0.2257, 0.1150), scale = 0.028) }
body Crafted_Table_boards_2 { type = mesh file = "../models/crafted/glass_of_water_Table_boards_2.obj" material = Crafted_Table_boards_2 position = (0, 0, 0) }
material Crafted_Table_boards_3 { type = diffuse texture = noise(a = rgb(0.4316, 0.2620, 0.1336), b = rgb(0.3927, 0.2384, 0.1216), scale = 0.028) }
body Crafted_Table_boards_3 { type = mesh file = "../models/crafted/glass_of_water_Table_boards_3.obj" material = Crafted_Table_boards_3 position = (0, 0, 0) }
material Crafted_Table_boards_4 { type = diffuse texture = noise(a = rgb(0.4546, 0.2760, 0.1407), b = rgb(0.4137, 0.2512, 0.1281), scale = 0.028) }
body Crafted_Table_boards_4 { type = mesh file = "../models/crafted/glass_of_water_Table_boards_4.obj" material = Crafted_Table_boards_4 position = (0, 0, 0) }
material Crafted_Table_boards_5 { type = diffuse texture = noise(a = rgb(0.4777, 0.2901, 0.1479), b = rgb(0.4348, 0.2640, 0.1346), scale = 0.028) }
body Crafted_Table_boards_5 { type = mesh file = "../models/crafted/glass_of_water_Table_boards_5.obj" material = Crafted_Table_boards_5 position = (0, 0, 0) }
material Crafted_Open_woodgrain { type = diffuse texture = noise(a = rgb(0.3000, 0.1750, 0.0800), b = rgb(0.2730, 0.1593, 0.0728), scale = 0.006) }
body Crafted_Open_woodgrain { type = mesh file = "../models/crafted/glass_of_water_Open_woodgrain.obj" material = Crafted_Open_woodgrain position = (0, 0, 0) }
# END CRAFTED MODELS
body Card  { type = sheet  size = (0.30, 0.20)  position = (0, 0.12, 0.10)  axis = (0, -1, 0)  up = (0, 0, 1)
             material = stripes }

body Glass { type = cup  outer_diameter = 76mm  wall = 2.5mm  base = 9mm  height = 115mm  level = 72mm
             glass = N-BK7  liquid = water
             rod = rod(diameter = 7mm, at = (14mm, 6mm), top = 0.175, material = red)
             position = (0, 0, 10um) }   # resting on the table without sharing a face

body Lamp { type = sphere  radius = 25mm  position = (-0.35, -0.25, 0.45)  material = black  emission = blackbody(3400K, 900) }

observer Eye { position = (0.02, -0.34, 0.115)  look_at = (0, 0, 0.07)  fov = 34deg  pupil = 3mm  focus = 0.34
               resolution = (480, 480) }

render { detector = Eye  spp = 256  integrator = hybrid }
