# THE CAMERA OBSCURA WITH A LENS — a dark room whose front wall holds a single lens (f = 3 m, f/10).
# The sunlit garden outside is projected, inverted, onto the white back wall. The observer
# stands inside. No projection is computed anywhere: camera paths leave the back wall,
# pass the lens and meet the garden like any other light path.
# The diffuse BackWall screen guides most camera-path continuations toward the lens,
# with a cosine-hemisphere mixture for indirect light. Inside sees the reflected image;
# selecting BackWall gives the screen's irradiance readout, not an exterior camera view.
units = m

world {
    sky = gradient(zenith = rgb(0.3, 0.5, 1.0, luminance = 1.0), horizon = rgb(0.9, 0.93, 1.0, luminance = 2.0),
                   ground = rgb(0.3, 0.3, 0.3, luminance = 0.3))
    sun { elevation = 50deg  azimuth = 150deg  luminance = 3e5 }
}

material lime    { type = diffuse  reflectance = rgb(0.9, 0.9, 0.86) }
material soot    { type = diffuse  reflectance = 0.03 }
material grass   { type = diffuse  texture = noise(a = rgb(0.15, 0.35, 0.08), b = rgb(0.25, 0.42, 0.12), scale = 0.4) }
material red     { type = diffuse  reflectance = rgb(0.85, 0.12, 0.08) }
material yellow  { type = diffuse  reflectance = rgb(0.9, 0.75, 0.1) }
material blue    { type = diffuse  reflectance = rgb(0.1, 0.25, 0.8) }
material leaves  { type = diffuse  reflectance = rgb(0.08, 0.3, 0.07) }
material bark    { type = diffuse  reflectance = rgb(0.3, 0.2, 0.12) }

# The room: interior x ∈ [-1.5, 1.5], y ∈ [-3.9, 0], z ∈ [0, 2.6]; the lens wall is at y = 0.
body Floor   { type = box  size = (3.4, 4.3, 0.2)  position = (0, -1.95, -0.1)  material = soot }
# BEGIN CRAFTED MODELS
# Generated by tools/build_scene_models.py; edit its recipes to regenerate.
material Crafted_Worn_floorboards_0 { type = diffuse texture = noise(a = rgb(0.0560, 0.0376, 0.0240), b = rgb(0.0510, 0.0342, 0.0218), scale = 0.006) }
body Crafted_Worn_floorboards_0 { type = mesh file = "../models/crafted/camera_obscura_Worn_floorboards_0.obj" material = Crafted_Worn_floorboards_0 position = (0, 0, 0) }
material Crafted_Worn_floorboards_1 { type = diffuse texture = noise(a = rgb(0.0630, 0.0423, 0.0270), b = rgb(0.0573, 0.0385, 0.0246), scale = 0.006) }
body Crafted_Worn_floorboards_1 { type = mesh file = "../models/crafted/camera_obscura_Worn_floorboards_1.obj" material = Crafted_Worn_floorboards_1 position = (0, 0, 0) }
material Crafted_Worn_floorboards_2 { type = diffuse texture = noise(a = rgb(0.0700, 0.0470, 0.0300), b = rgb(0.0637, 0.0428, 0.0273), scale = 0.006) }
body Crafted_Worn_floorboards_2 { type = mesh file = "../models/crafted/camera_obscura_Worn_floorboards_2.obj" material = Crafted_Worn_floorboards_2 position = (0, 0, 0) }
material Crafted_Worn_floorboards_3 { type = diffuse texture = noise(a = rgb(0.0770, 0.0517, 0.0330), b = rgb(0.0701, 0.0470, 0.0300), scale = 0.006) }
body Crafted_Worn_floorboards_3 { type = mesh file = "../models/crafted/camera_obscura_Worn_floorboards_3.obj" material = Crafted_Worn_floorboards_3 position = (0, 0, 0) }
material Crafted_Worn_floorboards_4 { type = diffuse texture = noise(a = rgb(0.0840, 0.0564, 0.0360), b = rgb(0.0764, 0.0513, 0.0328), scale = 0.006) }
body Crafted_Worn_floorboards_4 { type = mesh file = "../models/crafted/camera_obscura_Worn_floorboards_4.obj" material = Crafted_Worn_floorboards_4 position = (0, 0, 0) }
# END CRAFTED MODELS
body Ceiling { type = box  size = (3.4, 4.3, 0.2)  position = (0, -1.95, 2.7)   material = soot }
body WallL   { type = box  size = (0.2, 4.3, 2.6)  position = (-1.6, -1.95, 1.3) material = soot }
body WallR   { type = box  size = (0.2, 4.3, 2.6)  position = (1.6, -1.95, 1.3)  material = soot }
body Back    { type = box  size = (3.0, 0.2, 2.6)  position = (0, -4.0, 1.3)    material = lime }
# Front wall with a square opening (0.4 m) around the lens at (0, 0, 1.5).
body FrontL  { type = box  size = (1.3, 0.2, 2.6)  position = (-0.85, 0.1, 1.3)  material = soot }
body FrontR  { type = box  size = (1.3, 0.2, 2.6)  position = (0.85, 0.1, 1.3)   material = soot }
body FrontB  { type = box  size = (0.4, 0.2, 1.3)  position = (0, 0.1, 0.65)    material = soot }
body FrontT  { type = box  size = (0.4, 0.2, 0.9)  position = (0, 0.1, 2.15)    material = soot }
# The lens and a black plate that closes the corners of the square opening around it.
body Lens    { type = lens  medium = N-BK7  focal = 3000mm  form = bi  diameter = 300mm  thickness = 10mm
               rim = black  position = (0, 0.005, 1.5)  axis = (0, -1, 0) }
body Plate   { type = stop  aperture = 300.001mm  outer_diameter = 0.6  position = (0, -0.002, 1.5)  axis = (0, -1, 0) }

# The garden, 12–25 m away.
body Lawn    { type = sheet  size = (200, 200)  position = (0, 0, -0.001)  material = grass }
body Crate   { type = box  size = (1.5, 1.5, 1.5)  position = (-2.5, 14, 0.75)  rotate = (0, 0, 20deg)  material = red }
body Ball    { type = sphere  radius = 1.0  position = (1.8, 12, 1.0)  material = yellow }
body Column  { type = cylinder  radius = 0.5  height = 4  position = (4.5, 20, 0)  material = blue }
body Trunk   { type = cylinder  radius = 0.25  height = 3  position = (-6, 22, 0)  material = bark }
body Crown   { type = sphere  radius = 2.2  position = (-6, 22, 4.2)  material = leaves }

# A diffuse measurement screen lining the back wall both scatters light into the room and
# measures the projected irradiance. Its sampling aim favours the lens while retaining
# hemisphere samples for indirect light scattered by the room.
sensor BackWall { size = (2.9, 2.5)  resolution = (464, 400)  position = (0, -3.899, 1.3)  axis = (0, 1, 0)  up = (0, 0, 1)
                  material = lime
                  aim_center = (0, 0, 1.5)  aim_axis = (0, 1, 0)  aim_diameter = 0.31 }

observer Inside { position = (0.9, -0.6, 1.6)  look_at = (0, -3.9, 1.2)  fov = 55deg  pupil = 4mm  focus = 3.4
                  resolution = (480, 320) }

render { detector = Inside  spp = 256 }
