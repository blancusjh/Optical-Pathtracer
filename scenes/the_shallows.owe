# THE SHALLOWS — sunlight through the rippled surface of shallow sea water over sand, stones and
# weed, seen from above. The bright network on the bottom is not a texture: every line is a fold
# caustic, where the surface's curvature focuses the sun onto the sand, and where the fold is sharp
# enough the water's dispersion (n = 1.331 at 700 nm, 1.343 at 400 nm, Daimon & Masumura) draws a
# thin rainbow along its edge. The same ripples distort the stones seen through them.
# (After "Ripples dispersing sunlight into underwater rainbows in Brofjorden", Wikimedia Commons.)
units = m

world {
    sky = gradient(zenith = rgb(0.30, 0.50, 1.0, luminance = 0.45),
                   horizon = rgb(0.85, 0.90, 1.0, luminance = 0.9),
                   ground = rgb(0.25, 0.25, 0.22, luminance = 0.15))
    sun { elevation = 58deg  azimuth = 20deg  luminance = 1.2e5 }
}

# Coastal sea water: pure water's index and absorption plus dissolved organic matter (absorbing blue)
# and phytoplankton, whose combined absorption leaves the green window of a fjord (Jerlov coastal
# type 3, approximately; 1/m).
medium seawater { base = water
                  absorption = tabulated(lambda = [380, 400, 450, 500, 550, 600, 650, 700, 750, 800],
                                         values = [1.60, 1.15, 0.55, 0.28, 0.20, 0.42, 0.55, 0.85, 2.7, 2.3]) }

material sand   { type = diffuse  texture = noise(a = rgb(0.62, 0.56, 0.42), b = rgb(0.46, 0.41, 0.30), scale = 6mm)
                  relief = noise(scale = 8mm, depth = 0.8mm, octaves = 3) }   # a rippled, grainy bed
material stone  { type = diffuse  texture = noise(a = rgb(0.34, 0.33, 0.30), b = rgb(0.20, 0.19, 0.17), scale = 9mm) }
material pebble { type = diffuse  texture = noise(a = rgb(0.55, 0.50, 0.44), b = rgb(0.36, 0.33, 0.28), scale = 4mm) }
material weed   { type = diffuse  texture = noise(a = rgb(0.13, 0.16, 0.06), b = rgb(0.07, 0.09, 0.03), scale = 5mm) }

# Sea water 30 cm deep; the ripple field is a deterministic sum of 32 plane waves, 4–30 cm long,
# mostly travelling along 30° (a cross-sea from a wider spread of directions draws the cells).
body Sea { type = waves  size = (2.6, 2.6)  depth = 0.30  margin = 0.35  medium = seawater  bottom = sand  walls = sand
           base = 0.15   # deep enough to hold the sunk stones (the deepest reaches 0.12 below the bed)
           waves = ripples(count = 32, seed = 11, wavelength = (4cm, 30cm), slope = 0.16, direction = 30deg,
                           spread = 140deg) }

# Stones resting on (and sunk into) the sand, and patches of weed lying on it, all under water.
body Stone1  { type = sphere  radius = 9cm   position = (0.12, 0.25, -0.33)  material = stone   in = Sea }
body Stone2  { type = sphere  radius = 6cm   position = (-0.28, 0.02, -0.325) material = stone  in = Sea }
body Stone3  { type = sphere  radius = 4cm   position = (0.34, -0.12, -0.315) material = pebble in = Sea }
body Stone4  { type = sphere  radius = 2.5cm position = (-0.05, -0.30, -0.3)  material = pebble in = Sea }
body Stone5  { type = sphere  radius = 3cm   position = (-0.40, 0.38, -0.31)  material = stone  in = Sea }
body Weed1   { type = disk  radius = 14cm  position = (-0.18, 0.30, -0.297)  material = weed  in = Sea }
body Weed2   { type = disk  radius = 9cm   position = (0.30, 0.38, -0.297)   material = weed  in = Sea }
body Weed3   { type = disk  radius = 11cm  position = (0.02, -0.08, -0.297)  material = weed  in = Sea }

# Looking down into the water from 1.3 m, as a swimmer standing in it would.
observer Eye { position = (0.02, -0.45, 1.25)  look_at = (0.02, 0.10, -0.30)  up = (0, 1, 0)
               fov = 44deg  pupil = 4mm  focus = 1.65  resolution = (960, 640) }

render { detector = Eye  spp = 512  integrator = vcm }
