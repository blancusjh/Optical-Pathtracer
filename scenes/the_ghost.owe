# THE GHOST — a bright lamp at night photographed through an uncoated Petzval-type objective
# behind a flat protective filter.
# Every air–glass surface reflects a few percent; light bouncing twice inside the lens forms
# ghost images of the lamp. They are not added by a flare shader: they are camera paths that
# met a Fresnel reflection twice. For this design they are strongly defocused and spread over
# the whole frame as a faint veil — inspect them with
#   owe emit scenes/the_ghost.owe --from -0.6,6.43,2.35 --toward 0.2,-1.5,1.6 --cone 0.1 --rays 40000
# (≈0.4% of the flux reaching the sensor arrives by double reflections). fresnel_floor makes
# the renderer explore those branches more often without changing the expected image.
units = m

world { sky = gradient(zenith = rgb(0.05, 0.08, 0.2, luminance = 0.004), horizon = rgb(0.2, 0.18, 0.25, luminance = 0.01)) }

material asphalt { type = diffuse  texture = noise(a = rgb(0.10, 0.10, 0.11), b = rgb(0.18, 0.18, 0.19), scale = 0.05) }
material brick   { type = diffuse  texture = checker(a = rgb(0.16, 0.08, 0.05), b = rgb(0.10, 0.05, 0.035), scale = 0.25) }

body Street   { type = sheet  size = (60, 60)  material = asphalt }
# BEGIN CRAFTED MODELS
# Generated by tools/build_scene_models.py; edit its recipes to regenerate.
material Crafted_Curb_granite_0 { type = diffuse texture = noise(a = rgb(0.2322, 0.2193, 0.2064), b = rgb(0.2113, 0.1996, 0.1878), scale = 0.028) }
body Crafted_Curb_granite_0 { type = mesh file = "../models/crafted/the_ghost_Curb_granite_0.obj" material = Crafted_Curb_granite_0 position = (0, 0, 0) }
material Crafted_Curb_granite_1 { type = diffuse texture = noise(a = rgb(0.2511, 0.2371, 0.2232), b = rgb(0.2285, 0.2158, 0.2031), scale = 0.028) }
body Crafted_Curb_granite_1 { type = mesh file = "../models/crafted/the_ghost_Curb_granite_1.obj" material = Crafted_Curb_granite_1 position = (0, 0, 0) }
material Crafted_Curb_granite_2 { type = diffuse texture = noise(a = rgb(0.2700, 0.2550, 0.2400), b = rgb(0.2457, 0.2321, 0.2184), scale = 0.028) }
body Crafted_Curb_granite_2 { type = mesh file = "../models/crafted/the_ghost_Curb_granite_2.obj" material = Crafted_Curb_granite_2 position = (0, 0, 0) }
material Crafted_Curb_granite_3 { type = diffuse texture = noise(a = rgb(0.2889, 0.2729, 0.2568), b = rgb(0.2629, 0.2483, 0.2337), scale = 0.028) }
body Crafted_Curb_granite_3 { type = mesh file = "../models/crafted/the_ghost_Curb_granite_3.obj" material = Crafted_Curb_granite_3 position = (0, 0, 0) }
material Crafted_Curb_granite_4 { type = diffuse texture = noise(a = rgb(0.3078, 0.2907, 0.2736), b = rgb(0.2801, 0.2645, 0.2490), scale = 0.028) }
body Crafted_Curb_granite_4 { type = mesh file = "../models/crafted/the_ghost_Curb_granite_4.obj" material = Crafted_Curb_granite_4 position = (0, 0, 0) }
material Crafted_Road_aggregate_0 { type = diffuse texture = noise(a = rgb(0.0874, 0.0889, 0.0912), b = rgb(0.0795, 0.0809, 0.0830), scale = 0.028) }
body Crafted_Road_aggregate_0 { type = mesh file = "../models/crafted/the_ghost_Road_aggregate_0.obj" material = Crafted_Road_aggregate_0 position = (0, 0, 0) }
material Crafted_Road_aggregate_1 { type = diffuse texture = noise(a = rgb(0.1058, 0.1076, 0.1104), b = rgb(0.0963, 0.0980, 0.1005), scale = 0.028) }
body Crafted_Road_aggregate_1 { type = mesh file = "../models/crafted/the_ghost_Road_aggregate_1.obj" material = Crafted_Road_aggregate_1 position = (0, 0, 0) }
material Crafted_Road_aggregate_2 { type = diffuse texture = noise(a = rgb(0.1242, 0.1264, 0.1296), b = rgb(0.1130, 0.1150, 0.1179), scale = 0.028) }
body Crafted_Road_aggregate_2 { type = mesh file = "../models/crafted/the_ghost_Road_aggregate_2.obj" material = Crafted_Road_aggregate_2 position = (0, 0, 0) }
material Crafted_Road_aggregate_3 { type = diffuse texture = noise(a = rgb(0.1426, 0.1451, 0.1488), b = rgb(0.1298, 0.1320, 0.1354), scale = 0.028) }
body Crafted_Road_aggregate_3 { type = mesh file = "../models/crafted/the_ghost_Road_aggregate_3.obj" material = Crafted_Road_aggregate_3 position = (0, 0, 0) }
# END CRAFTED MODELS
body Post     { type = cylinder  radius = 0.035  height = 2.28  position = (-0.62, 6.5, 0)  material = grey }
body Lantern  { type = sphere  radius = 0.06  position = (-0.62, 6.5, 2.36)  material = black
                emission = blackbody(2900K, 3e4) }

camera Cam { lens = "../lenses/petzval_100mm_filter.lens"  sensor = (36mm, 24mm)  resolution = (540, 360)
             position = (0.2, -1.5, 1.6)  look_at = (0.2, 22, 1.6)  focus = 8 }

render { detector = Cam  spp = 1024  exposure = 9  auto_exposure = false  fresnel_floor = 0.25 }
